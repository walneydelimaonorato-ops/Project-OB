config_version=5

[application]

config/name="OATHBREAKER"
config/version="UNAUTHORIZED 000"
run/main_scene="uid://cqhq1cwbpob5s"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0, 0, 0, 0)
boot_splash/show_image=false
boot_splash/use_filter=false
config/icon="uid://bnatj3bn5b0af"
boot_splash/minimum_display_time=3000

[autoload]

Global="*uid://chd33wii2ykgf"
SignalBus="*uid://chyio332ihmub"
FpsCounter="*uid://fbjesgifv3jo"

